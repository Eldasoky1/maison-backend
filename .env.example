# ── Supabase ────────────────────────────────────────────────────────────────
# Project settings → API. The anon key is safe in the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://dxxnaxbnpjwbktbhgndm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by admin actions and the seed script. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenRouter (server only — used by Edge Functions, not by Next.js) ───────
# Set with: supabase secrets set OPENROUTER_API_KEY=... 
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=anthropic/claude-sonnet-4.5
EXTRACTION_MODEL=anthropic/claude-haiku-4.5
EMBEDDING_MODEL=openai/text-embedding-3-small
VISION_MODEL=google/gemini-2.5-flash
FALLBACK_MODELS=openai/gpt-4.1-mini,google/gemini-2.5-flash
DAILY_SPEND_CAP_USD=2.00

# ── Client-side ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# When Supabase env vars are absent the UI renders curated demo content.
NEXT_PUBLIC_DEMO_MODE=false
